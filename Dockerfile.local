FROM python:3.12-slim AS local-python-base

WORKDIR /workspace

RUN pip install --no-cache-dir boto3
RUN pip install --no-cache-dir watchfiles

COPY lambdas/lambda_worker /workspace/lambdas/lambda_worker
COPY local/invoke_harness.py /workspace/local/invoke_harness.py


FROM local-python-base AS local-lambda-base

COPY lib /workspace/lib
COPY lambdas/lib /workspace/lambdas/lib


FROM local-lambda-base AS lambda-api-local

ENV PYTHONPATH=/workspace/lib:/workspace/lambdas/lib:/workspace/lambdas/lambda_api:/workspace/local

CMD ["sh", "-lc", "watchfiles --filter python \"python /workspace/local/api_harness.py lambda_handler:lambda_handler\" /workspace/lambdas/lambda_api /workspace/lambdas/lib /workspace/lib /workspace/local"]


FROM local-lambda-base AS lambda-worker-local

ENV PYTHONPATH=/workspace/lib:/workspace/lambdas/lib:/workspace/lambdas/lambda_worker:/workspace/local

CMD ["sh", "-lc", "watchfiles --filter python \"python /workspace/local/invoke_harness.py lambda_handler:lambda_handler --event-file /workspace/local/lambda_worker_event.json\" /workspace/lambdas/lambda_worker /workspace/lambdas/lib /workspace/lib /workspace/local"]


FROM local-lambda-base AS migrations-local

COPY lambdas/migrations /workspace/lambdas/migrations

RUN pip install --no-cache-dir -r /workspace/lambdas/migrations/requirements.txt

ENV PYTHONPATH=/workspace/lib:/workspace/lambdas/lib:/workspace/lambdas/migrations

CMD ["sh", "-lc", "python -c \"from lambda_handler import run_migration; run_migration()\" && watchfiles --filter python \"python -c 'from lambda_handler import run_migration; run_migration()'\" /workspace/lambdas/migrations"]
